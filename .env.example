# 复制为 .env 后按需修改；compose 会自动读取同目录 .env
# 408 大题工位：宿主机端口 -> 容器 80
EXAM408_PORT=40810

# 英语真题档案：宿主机端口 -> 容器 80
# 注意：macOS 的 AirPlay 接收器常占用 5000，所以本地默认用 5001。
ENGLISH_PORT=5001

# 项目名默认来自 compose.yaml 的 name: study-sites。
# 如果在同一个仓库的多个 worktree 里并行开发，不要改 compose.yaml，
# 用环境变量覆盖项目名即可，容器名也会自动分开：
#
#   408 worktree:     COMPOSE_PROJECT_NAME=study-408 docker compose up -d --build exam408
#   English worktree: COMPOSE_PROJECT_NAME=study-english docker compose up -d --build english
#
# 详细说明见 BRANCHING.md。
